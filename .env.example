# Lovable Cloud / Supabase configuration
# Get these values from your Lovable Cloud project (Settings → Backend)
# or, if you connected an external Supabase project, from the
# Supabase Dashboard → Project Settings → API.
#
# - VITE_SUPABASE_URL              The Project URL (e.g. https://xxxx.supabase.co)
# - VITE_SUPABASE_PUBLISHABLE_KEY  The publishable (anon) key — safe to expose to the browser
# - VITE_SUPABASE_PROJECT_ID       The project ref id (used by generated types)
#
# Never put the service_role key or database password in this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=